{%- set pixel = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" -%}
<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ site.titulo }}</title>
  <meta name="description" content="{{ site.descripcion }}" />
  <meta name="theme-color" content="{{ site.themeColor }}" />

  <!-- Vista previa al compartir el enlace (WhatsApp, Facebook, etc.)
       TODO producción: og:url y og:image necesitan la URL ABSOLUTA del dominio final.
       Mientras tanto WhatsApp mostrará el enlace sin imagen. -->
  <meta property="og:type" content="{{ site.og.type }}" />
  <meta property="og:locale" content="{{ site.og.locale }}" />
  <meta property="og:site_name" content="{{ site.og.siteName }}" />
  <meta property="og:title" content="{{ site.og.titulo }}" />
  <meta property="og:description" content="{{ site.og.descripcion }}" />
  <!-- <meta property="og:url" content="https://DOMINIO-FINAL/" /> -->
  <!-- <meta property="og:image" content="https://DOMINIO-FINAL/assets/wayback-banda.jpeg" /> -->
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23e11d2e'/%3E%3Ctext x='16' y='23' font-size='17' font-family='Arial' font-weight='900' fill='white' text-anchor='middle'%3EW%3C/text%3E%3C/svg%3E" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700;12..96,800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="styles.css?v=3" />
</head>
<body>
  <!-- ===== NAV ===== -->
  <header class="nav" id="nav">
    <a href="#hero" class="brand"><span class="brand__mark">W</span> {{ site.marca }}</a>
    <nav class="nav__links" id="navLinks" aria-label="Navegación principal">
      {%- for enlace in site.nav %}
      <a href="{{ enlace.href }}">{{ enlace.texto }}</a>
      {%- endfor %}
    </nav>
    <button class="nav__toggle" id="navToggle" aria-label="Abrir menú" aria-expanded="false"><span></span><span></span><span></span></button>
  </header>

  <main>
    <!-- ===== 1. HERO ===== -->
    <section class="hero" id="hero">
      <div class="hero__pattern" aria-hidden="true"></div>
      <div class="hero__shapes" aria-hidden="true"><span></span><span></span><span></span></div>

      <div class="hero__layout">
        <div class="hero__content">
          <h1 class="hero__title reveal">{{ hero.titulo }}</h1>
          <p class="hero__line reveal" aria-label="{{ hero.frases[0] }}"><span id="typeLine" class="type"></span><span class="caret" aria-hidden="true"></span></p>
          <p class="hero__subtitle reveal">{{ hero.subtitulo }}</p>
          <div class="hero__actions reveal">
            {%- for accion in hero.acciones %}
            <a class="btn {{ accion.clase }}" href="{{ accion.href }}"{% if accion.externo %} target="_blank" rel="noopener"{% endif %}>{{ accion.texto }}</a>
            {%- endfor %}
          </div>
        </div>

        <figure class="hero__photo reveal">
          <div class="hero__photo-frame">
            <img src="{{ hero.foto.src }}" alt="{{ hero.foto.alt }}" />
          </div>
          <figcaption>{{ hero.foto.caption }}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ===== 2. SOBRE NOSOTROS ===== -->
    <section class="section" id="sobre">
      <div class="container">
        <div class="card card--blue tilt reveal">
          <span class="card__num">{{ sobre.num }}</span>
          <h2 class="card__title">{{ sobre.titulo }}</h2>
          {%- for parrafo in sobre.parrafos %}
          {% if loop.first %}<p class="lead">{{ parrafo | safe }}</p>{% else %}<p>{{ parrafo | safe }}</p>{% endif %}
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- ===== 3. MÚSICA ===== -->
    <section class="section" id="musica">
      <div class="container">
        <header class="section__title reveal"><span class="badge-num">{{ musica.num }}</span><h2>{{ musica.titulo }}</h2></header>

        <div class="split">
          <div class="card card--purple tilt reveal">
            <h3>{{ musica.proximos.titulo }}</h3>
            <ul class="ticks">
              {%- for item in musica.proximos.items %}
              <li>{{ item }}</li>
              {%- endfor %}
            </ul>
          </div>
          <div class="card card--red tilt reveal">
            <h3>{{ musica.recientes.titulo }}</h3>
            <ul class="ticks">
              {%- for item in musica.recientes.items %}
              <li>{{ item.titulo }} <em>{{ item.nota }}</em></li>
              {%- endfor %}
            </ul>
          </div>
        </div>

        <div class="music-grid">
          {%- for video in musica.videos %}
          <article class="yt-lite reveal" data-id="{{ video.id }}" data-title="{{ video.titulo }}">
            <img src="{{ pixel }}" data-ph="{{ video.ph }}" alt="{{ video.alt }}" />
            <button class="yt-lite__play" aria-label="Reproducir">▶</button>
            <span class="yt-lite__cap">{{ video.caption }}</span>
          </article>
          {%- endfor %}
        </div>

        <div class="spotify reveal">
          <iframe title="WayBack en Spotify" style="border-radius:16px" src="https://open.spotify.com/embed/artist/{{ musica.spotifyArtistId }}?utm_source=generator" width="100%" height="352" frameborder="0" allowfullscreen allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
      </div>
    </section>

    <!-- ===== 4. EVENTOS ===== -->
    <section class="section" id="eventos">
      <div class="container">
        <header class="section__title reveal"><span class="badge-num">03</span><h2>Eventos</h2></header>
        <div class="events">
          <article class="event-card event-card--soon tilt reveal">
            <div class="event-card__date"><strong>2026</strong><span>Por confirmar</span></div>
            <h3>Honduras Adora 2026</h3>
            <p>Festival de adoración · Honduras</p>
            <span class="pill">Próximamente</span>
          </article>
          <article class="event-card tilt reveal">
            <div class="event-card__date"><strong>15</strong><span>AGO 2026</span></div>
            <h3>Noche de Adoración</h3>
            <p>Tegucigalpa, Honduras</p>
            <span class="pill pill--ghost">Concierto</span>
          </article>
          <article class="event-card tilt reveal">
            <div class="event-card__date"><strong>27</strong><span>SEP 2026</span></div>
            <h3>WayBack en Vivo</h3>
            <p>San Pedro Sula, Honduras</p>
            <span class="pill pill--ghost">Concierto</span>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== 5. MERCH ===== -->
    <section class="section" id="merch">
      <div class="container">
        <header class="section__title reveal"><span class="badge-num">04</span><h2>Merch</h2></header>
        <div class="merch-grid">
          <figure class="merch-card tilt reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="600/600" alt="Hoodie WayBack" /><figcaption><strong>Hoodie "De Regreso"</strong><span>Edición limitada</span></figcaption></figure>
          <figure class="merch-card tilt reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="600/600" alt="Camiseta WayBack" /><figcaption><strong>Camiseta Catracha</strong><span>Algodón premium</span></figcaption></figure>
          <figure class="merch-card tilt reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="600/600" alt="Gorra WayBack" /><figcaption><strong>Gorra Bordada</strong><span>Logo WayBack</span></figcaption></figure>
          <figure class="merch-card tilt reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="600/600" alt="Tote bag WayBack" /><figcaption><strong>Tote Bag</strong><span>Honduras Adora</span></figcaption></figure>
        </div>
        <div class="card card--white merch-cta reveal">
          <p>Adquiérela vía WhatsApp: <strong>9623-6221</strong>. No tenemos tienda en línea por el momento.</p>
          <a class="btn btn--green" href="https://wa.me/50496236221" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.413c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.207zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            Comprar por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- ===== 6. HONDURAS ADORA ===== -->
    <!-- NOTA: Próximamente hondurasadora.com redirigirá a esta sección / sitio. -->
    <section class="section section--festival" id="honduras-adora">
      <div class="hero__pattern hero__pattern--soft" aria-hidden="true"></div>
      <div class="container">
        <header class="section__title section__title--light reveal"><span class="badge-num badge-num--light">05</span><h2>Honduras Adora</h2></header>
        <p class="festival-lead reveal">"Honduras Adora", es un festival de música cristiana, que reúne a ministros de diferentes países, con la visión de interceder por la nación y declarar, que Honduras es tierra de adoración.</p>
        <p class="notice reveal">📍 Próximamente <strong>hondurasadora.com</strong> redirigirá aquí.</p>

        <div class="gallery">
          <figure class="reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="420/520" alt="Ágape Worship · 2024" /><figcaption>Ágape Worship · 2024</figcaption></figure>
          <figure class="reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="420/520" alt="WayBack · 2024" /><figcaption>WayBack · 2024</figcaption></figure>
          <figure class="reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="420/520" alt="Julián & Becky Collazos · 2024" /><figcaption>Julián &amp; Becky Collazos</figcaption></figure>
          <figure class="reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="420/520" alt="Bani Muñoz" /><figcaption>Bani Muñoz · 24/25</figcaption></figure>
          <figure class="reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="420/520" alt="Juan Carlos Alvarado · 2024" /><figcaption>Juan Carlos Alvarado</figcaption></figure>
          <figure class="reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="420/520" alt="Averly Morillo · 2025" /><figcaption>Averly Morillo · 2025</figcaption></figure>
        </div>

        <div class="festival-cta reveal">
          <span class="festival-cta__year">2026</span>
          <p>La próxima edición está en camino. ¡Honduras es tierra de adoración!</p>
          <a class="btn btn--white" href="#invitaciones">Quiero participar</a>
        </div>
      </div>
    </section>

    <!-- ===== 7. INVITACIONES ===== -->
    <section class="section" id="invitaciones">
      <div class="container container--narrow">
        <header class="section__title reveal"><span class="badge-num">06</span><h2>Invitaciones</h2></header>
        <p class="section__desc reveal">¿Quieres que WayBack ministre en tu iglesia o evento? Escríbenos.</p>
        <form class="card card--white form reveal" id="formInvitacion" novalidate>
          <div class="form__row">
            <label class="field"><span>Nombre *</span><input type="text" name="nombre" required /></label>
            <label class="field"><span>Iglesia / Ministerio *</span><input type="text" name="iglesia" required /></label>
          </div>
          <div class="form__row">
            <label class="field"><span>Ciudad *</span><input type="text" name="ciudad" required /></label>
            <label class="field"><span>Correo *</span><input type="email" name="correo" required /></label>
          </div>
          <label class="field"><span>Teléfono *</span><input type="tel" name="telefono" required inputmode="tel" pattern="[0-9+\-\s()]{8,}" /></label>
          <label class="field"><span>Mensaje</span><textarea name="mensaje" rows="4"></textarea></label>
          <button class="btn btn--red btn--block" type="submit">Enviar invitación</button>
          <p class="form__success" data-success hidden>✓ ¡Gracias! Recibimos tu invitación y te contactaremos pronto.</p>
        </form>
      </div>
    </section>

    <!-- ===== 8. RECURSOS ===== -->
    <section class="section" id="recursos">
      <div class="container">
        <header class="section__title reveal"><span class="badge-num">07</span><h2>Recursos</h2></header>
        <p class="section__desc reveal">Para músicos y cantantes: pistas, acordes y recursos para tocar la música de WayBack.</p>
        <div class="split split--3">
          <a class="card card--blue tilt reveal resource" href="#" onclick="return false"><span class="resource__icon">🎚️</span><h3>Pistas / Multitracks</h3><p>Stems y pistas de acompañamiento.</p></a>
          <a class="card card--purple tilt reveal resource" href="#" onclick="return false"><span class="resource__icon">🎸</span><h3>Acordes & Charts</h3><p>Cifrados y tonalidades por canción.</p></a>
          <a class="card card--red tilt reveal resource" href="#" onclick="return false"><span class="resource__icon">🎹</span><h3>Patches & Sonidos</h3><p>Presets para recrear nuestro sonido.</p></a>
        </div>
        <h3 class="subhead reveal">Galería de conciertos</h3>
        <div class="gallery gallery--wide">
          <figure class="reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="440/320" alt="Concierto WayBack" /></figure>
          <figure class="reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="440/320" alt="Concierto WayBack" /></figure>
          <figure class="reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="440/320" alt="Concierto WayBack" /></figure>
          <figure class="reveal"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="440/320" alt="Concierto WayBack" /></figure>
        </div>
      </div>
    </section>

    <!-- ===== 9. MAHANAIM RECORDS ===== -->
    <section class="section" id="mahanaim">
      <div class="container">
        <header class="section__title reveal"><span class="badge-num">08</span><h2>Mahanaim Records</h2></header>
        <div class="card card--purple reveal" style="margin-bottom:28px">
          <p class="lead" style="margin:0">Mahanaim Records es un ministerio/ONG que apoya a personas que quieren lanzar su música y no tienen tanto recurso para lograrlo.</p>
        </div>
        <div class="music-grid">
          <article class="yt-lite reveal" data-id="FqAj3bXxmG" data-title="ISA LOPEZ"><!-- TODO: confirmar ID de YouTube de ISA LOPEZ -->
            <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="640/360" alt="ISA LOPEZ" />
            <button class="yt-lite__play" aria-label="Reproducir">▶</button>
            <span class="yt-lite__cap">ISA LOPEZ · Mahanaim Records</span>
          </article>
          <article class="yt-lite reveal" data-id="G0D9iBJDhGA" data-title="JEFF CASTRO">
            <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-ph="640/360" alt="JEFF CASTRO" />
            <button class="yt-lite__play" aria-label="Reproducir">▶</button>
            <span class="yt-lite__cap">JEFF CASTRO · Mahanaim Records</span>
          </article>
        </div>
      </div>
    </section>

  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="container">
      <div class="footer__top">
        <div class="footer__brand">
          <a href="#hero" class="brand"><span class="brand__mark">W</span> WayBack</a>
          <p>De Regreso al Camino · Banda Hondureña de Electro-Pop Cristiano · wayback.org</p>
          <div class="socials">
            <a href="https://facebook.com/WayBackOficialHN" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.08 24 18.09 24 12.07z"/></svg></a>
            <a href="https://instagram.com/waybackoficial" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zM12 16a4 4 0 110-8 4 4 0 010 8zm6.41-10.85a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z"/></svg></a>
            <a href="https://tiktok.com/@waybackoficial" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64c.3 0 .59.04.86.13V9.4a6.33 6.33 0 00-1-.05A6.34 6.34 0 005 20.1a6.34 6.34 0 0010.86-4.43V8.69a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1.04-.12z"/></svg></a>
            <a href="https://youtube.com/waybackoficial" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23.5 6.2a3.02 3.02 0 00-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.51A3.02 3.02 0 00.5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3.02 3.02 0 002.12 2.14c1.88.51 9.38.51 9.38.51s7.5 0 9.38-.51a3.02 3.02 0 002.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.8zM9.6 15.6V8.4l6.27 3.6-6.27 3.6z"/></svg></a>
          </div>
          <div class="platforms">
            <a href="https://open.spotify.com/artist/15S8x4SA16werdAc7KkJMd" target="_blank" rel="noopener">Spotify</a>
            <a href="https://music.youtube.com/@WayBackOficial" target="_blank" rel="noopener">YouTube Music</a>
          </div>
        </div>
        <div class="footer__mv">
          <h4>Misión</h4>
          <p>Ser un instrumento en las manos de Dios, creando música y espacios para que los hijos pródigos vuelvan al camino y aquellos que no le conocen, puedan aceptarlo como su Señor y Salvador.</p>
          <h4>Visión</h4>
          <p>Ser un ministerio orgullosamente hondureño, sano y enfocado, que llegue a todas las partes de Honduras, Centroamérica y el mundo, siendo íntegros en todo lo que hacemos.</p>
        </div>
      </div>
      <div class="footer__bottom">
        <span>© <span id="year"></span> WayBack · Hecho con fe en Honduras 🇭🇳</span>
        <a href="#hero">Volver arriba ↑</a>
      </div>
    </div>
  </footer>

  <script src="script.js?v=3"></script>
</body>
</html>
