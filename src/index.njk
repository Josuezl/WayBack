{%- import "iconos.njk" as ic -%}
<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ site.titulo }}</title>
  <meta name="description" content="{{ site.descripcion }}" />
  <meta name="theme-color" content="{{ site.themeColor }}" />

  <!-- Vista previa al compartir el enlace (WhatsApp, Facebook, etc.)
       TODO producción: og:url y og:image necesitan la URL ABSOLUTA del dominio final.
       Mientras tanto WhatsApp mostrará el enlace sin imagen. -->
  <meta property="og:type" content="{{ site.og.type }}" />
  <meta property="og:locale" content="{{ site.og.locale }}" />
  <meta property="og:site_name" content="{{ site.og.siteName }}" />
  <meta property="og:title" content="{{ site.og.titulo }}" />
  <meta property="og:description" content="{{ site.og.descripcion }}" />
  <!-- <meta property="og:url" content="https://DOMINIO-FINAL/" /> -->
  <!-- <meta property="og:image" content="https://DOMINIO-FINAL/assets/wayback-banda.jpeg" /> -->
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23e11d2e'/%3E%3Ctext x='16' y='23' font-size='17' font-family='Arial' font-weight='900' fill='white' text-anchor='middle'%3EW%3C/text%3E%3C/svg%3E" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500..800&family=Manrope:wght@400..800&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="styles.css?v=15" />
</head>
<body>
  <!-- ===== NAV ===== -->
  <header class="nav" id="nav">
    <a href="#hero" class="brand"><span class="brand__mark">W</span> {{ site.marca }}</a>
    <nav class="nav__links" id="navLinks" aria-label="Navegación principal">
      {%- for enlace in site.nav %}
      <a href="{{ enlace.href }}">{{ enlace.texto }}</a>
      {%- endfor %}
    </nav>
    <button class="nav__toggle" id="navToggle" aria-label="Abrir menú" aria-expanded="false"><span></span><span></span><span></span></button>
  </header>

  <main>
    <!-- ===== 1. HERO ===== -->
    <section class="hero" id="hero">
      {#- El video se monta aqui por JS y aparece solo cuando ya esta
          reproduciendo. Si nunca carga, queda el hero de siempre. #}
      <div class="hero__video" id="heroVideo" aria-hidden="true" data-video-id="{{ hero.video.id }}"><div id="heroVideoMount"></div></div>
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__pattern" aria-hidden="true"></div>
      <div class="hero__shapes" aria-hidden="true"><span></span><span></span><span></span></div>

      <div class="hero__layout">
        <div class="hero__content">
          <h1 class="hero__title reveal">{{ hero.titulo }}</h1>
          <p class="hero__line reveal" aria-label="{{ hero.frases[0] }}"><span id="typeLine" class="type"></span><span class="caret" aria-hidden="true"></span></p>
          <p class="hero__subtitle reveal">{{ hero.subtitulo }}</p>
          <div class="hero__actions reveal">
            {%- for accion in hero.acciones %}
            <a class="btn {{ accion.clase }}" href="{{ accion.href }}"{% if accion.externo %} target="_blank" rel="noopener"{% endif %}>{{ accion.texto }}</a>
            {%- endfor %}
          </div>
          <div class="hero__socials reveal">
            {%- for r in hero.redes %}
            <a href="{{ r.href }}" target="_blank" rel="noopener" aria-label="{{ r.nombre }}">{{ ic.red(r.nombre, 22) }}</a>
            {%- endfor %}
          </div>
        </div>

        <figure class="hero__photo reveal">
          <div class="hero__photo-frame">
            <img src="{{ hero.foto.src }}" alt="{{ hero.foto.alt }}" />
          </div>
          <figcaption>{{ hero.foto.caption }}</figcaption>
        </figure>
      </div>

      {#- El video arranca en mudo porque los navegadores prohiben el autoplay
          con audio; este boton lo activa. Nace oculto y solo aparece si el
          video llego a reproducir.

          El icono y el texto describen los dos la ACCION, no el estado. Antes
          el texto decia "Silenciar" junto a una bocina sonando —uno la accion,
          el otro el estado— y se leia al reves. Sin aria-pressed a proposito:
          mezclar etiqueta cambiante con estado de pulsado es justo lo que
          confunde; la etiqueta sola ya dice que pasa al hacer clic. #}
      <button class="hero__sound" id="heroSound" type="button" hidden
              data-suena="false"
              data-activar="{{ hero.video.activarSonido }}"
              data-silenciar="{{ hero.video.silenciar }}">
        <span class="hero__sound-ico hero__sound-ico--activar" aria-hidden="true">{{ ic.sonido("con", 18) }}</span>
        <span class="hero__sound-ico hero__sound-ico--silenciar" aria-hidden="true">{{ ic.sonido("mudo", 18) }}</span>
        <span class="hero__sound-txt">{{ hero.video.activarSonido }}</span>
      </button>
    </section>

    <!-- ===== 2. SOBRE NOSOTROS ===== -->
    <section class="section" id="sobre">
      <div class="container">
        <div class="card card--blue reveal sobre">
          <div class="sobre__texto">
            <h2 class="card__title">{{ sobre.titulo }}</h2>
            {%- for parrafo in sobre.parrafos %}
            {% if loop.first %}<p class="lead">{{ parrafo }}</p>{% else %}<p>{{ parrafo }}</p>{% endif %}
            {%- endfor %}
          </div>
          <figure class="sobre__foto">
            <div class="sobre__foto-frame">
              <img src="{{ sobre.foto.src }}" alt="{{ sobre.foto.alt }}" loading="lazy" />
            </div>
            <figcaption>{{ sobre.foto.caption }}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ===== 3. MÚSICA ===== -->
    <section class="section" id="musica">
      <div class="container">
        <header class="section__title reveal"><h2>{{ musica.titulo }}</h2></header>

        <div class="split">
          <div class="card card--purple tilt reveal">
            <h3>{{ musica.proximos.titulo }}</h3>
            <ul class="ticks">
              {%- for item in musica.proximos.items %}
              <li>{{ item }}</li>
              {%- endfor %}
            </ul>
          </div>
          <div class="card card--red tilt reveal">
            <h3>{{ musica.recientes.titulo }}</h3>
            <ul class="ticks">
              {%- for item in musica.recientes.items %}
              <li>{{ item.titulo }} <em>{{ item.nota }}</em></li>
              {%- endfor %}
            </ul>
          </div>
        </div>

        {#- Carrusel continuo. La pista se duplica por JS para que el bucle no
            tenga costura; sin JS queda una fila deslizable a mano, que
            funciona igual. #}
        <div class="carrusel" id="carruselMusica">
          <div class="carrusel__pista">
            {%- for video in musica.videos %}
            <article class="yt-lite reveal" data-id="{{ video.id }}" data-title="{{ video.titulo }}">
              <img src="https://i.ytimg.com/vi/{{ video.id }}/maxresdefault.jpg" alt="{{ video.alt }}" loading="lazy" onerror="imgFallback(this)" />
              <button class="yt-lite__play" aria-label="Reproducir">{{ ic.play(24) }}</button>
              <span class="yt-lite__cap">{{ video.caption }}</span>
            </article>
            {%- endfor %}
          </div>
        </div>

        <div class="spotify reveal">
          <iframe title="WayBack en Spotify" style="border-radius:16px" src="https://open.spotify.com/embed/artist/{{ musica.spotifyArtistId }}?utm_source=generator" width="100%" height="352" frameborder="0" allowfullscreen allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
      </div>
    </section>

    <!-- ===== 4. EVENTOS ===== -->
    <section class="section" id="eventos">
      <div class="container">
        <header class="section__title reveal"><h2>{{ eventos.titulo }}</h2></header>
        <div class="events">
          {%- for evento in eventos.items %}
          <article class="event-card{% if evento.destacado %} event-card--soon{% endif %} tilt reveal">
            <div class="event-card__date"><strong>{{ evento.fechaPrincipal }}</strong><span>{{ evento.fechaSecundaria }}</span></div>
            <h3>{{ evento.titulo }}</h3>
            <p>{{ evento.lugar }}</p>
            <span class="pill{% if not evento.destacado %} pill--ghost{% endif %}">{{ evento.etiqueta }}</span>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- ===== 5. MERCH ===== -->
    <section class="section" id="merch">
      <div class="container">
        <header class="section__title reveal"><h2>{{ merch.titulo }}</h2></header>
        <div class="merch-grid">
          {%- for producto in merch.productos %}
          <figure class="merch-card tilt reveal">{{ ic.foto(producto) }}<figcaption><strong>{{ producto.titulo }}</strong><span>{{ producto.subtitulo }}</span></figcaption></figure>
          {%- endfor %}
        </div>
        <div class="card card--white merch-cta reveal">
          <p>{{ merch.cta.textoAntes }}<strong>{{ merch.cta.telefono }}</strong>{{ merch.cta.textoDespues }}</p>
          <a class="btn btn--green" href="{{ merch.cta.whatsappUrl }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.413c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.207zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            {{ merch.cta.boton }}
          </a>
        </div>
      </div>
    </section>

    <!-- ===== 6. HONDURAS ADORA ===== -->
    <section class="section section--festival" id="honduras-adora">
      <div class="hero__pattern hero__pattern--soft" aria-hidden="true"></div>
      <div class="container">
        <header class="section__title section__title--light reveal"><h2>{{ hondurasAdora.titulo }}</h2></header>
        <p class="festival-lead reveal">{{ hondurasAdora.lead }}</p>

        <div class="gallery">
          {%- for foto in hondurasAdora.galeria %}
          <figure class="reveal">{{ ic.foto(foto) }}<figcaption>{{ foto.caption }}</figcaption></figure>
          {%- endfor %}
        </div>

        <div class="festival-cta reveal">
          <span class="festival-cta__year">{{ hondurasAdora.cta.anio }}</span>
          <p>{{ hondurasAdora.cta.texto }}</p>
          <a class="btn btn--white" href="{{ hondurasAdora.cta.href }}" target="_blank" rel="noopener">{{ hondurasAdora.cta.boton }}</a>
        </div>
      </div>
    </section>

    <!-- ===== 7. INVITACIONES ===== -->
    <section class="section" id="invitaciones">
      <div class="container container--narrow">
        <header class="section__title reveal"><h2>{{ invitaciones.titulo }}</h2></header>
        <p class="section__desc reveal">{{ invitaciones.descripcion }}</p>
        {{ ic.formulario(invitaciones, "formInvitacion") }}
      </div>
    </section>

    <!-- ===== 8. RECURSOS ===== -->
    <section class="section" id="recursos">
      <div class="container">
        <header class="section__title reveal"><h2>{{ recursos.titulo }}</h2></header>
        <p class="section__desc reveal">{{ recursos.descripcion }}</p>
        <div class="split split--3">
          {%- for tarjeta in recursos.tarjetas %}
          <a class="card {{ tarjeta.clase }} tilt reveal resource" href="#" onclick="return false"><span class="resource__icon">{{ tarjeta.icono }}</span><h3>{{ tarjeta.titulo }}</h3><p>{{ tarjeta.descripcion }}</p></a>
          {%- endfor %}
        </div>
        <h3 class="subhead reveal">{{ recursos.subtituloGaleria }}</h3>
        <div class="gallery gallery--wide">
          {%- for foto in recursos.galeria %}
          <figure class="reveal">{{ ic.foto(foto) }}</figure>
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- ===== 9. MAHANAIM RECORDS ===== -->
    <section class="section" id="mahanaim">
      <div class="container">
        <header class="section__title reveal"><h2>{{ mahanaim.titulo }}</h2></header>
        <div class="card card--purple reveal" style="margin-bottom:28px">
          <p class="lead" style="margin:0">{{ mahanaim.lead }}</p>
        </div>
        <div class="music-grid">
          {%- for video in mahanaim.videos %}
          <article class="yt-lite reveal" data-id="{{ video.id }}" data-title="{{ video.titulo }}">{% if video.comentario %}<!-- {{ video.comentario }} -->{% endif %}
            <img src="https://i.ytimg.com/vi/{{ video.id }}/maxresdefault.jpg" alt="{{ video.alt }}" loading="lazy" onerror="imgFallback(this)" />
            <button class="yt-lite__play" aria-label="Reproducir">{{ ic.play(24) }}</button>
            <span class="yt-lite__cap">{{ video.caption }}</span>
          </article>
          {%- endfor %}
        </div>

        <div class="mahanaim-form reveal">
          <h3 class="subhead">{{ mahanaim.formulario.titulo }}</h3>
          <p class="section__desc">{{ mahanaim.formulario.descripcion }}</p>
          {{ ic.formulario(mahanaim.formulario, "formMahanaim") }}
        </div>
      </div>
    </section>

    <!-- ===== 10. CONTACTO / NEWSLETTER ===== -->
    <section class="section section--cta" id="contacto">
      <div class="container container--narrow">
        <header class="section__title section__title--light reveal"><h2>{{ contacto.titulo }}</h2></header>
        <p class="section__desc section__desc--light reveal">{{ contacto.descripcion }}</p>
        {{ ic.formulario(contacto, "formContacto") }}
      </div>
    </section>

  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="container">
      <div class="footer__top">
        <div class="footer__brand">
          <a href="#hero" class="brand"><span class="brand__mark">W</span> {{ footer.marca }}</a>
          <p>{{ footer.tagline }}</p>
          <div class="socials">
            <a href="{{ footer.redes[0].href }}" target="_blank" rel="noopener" aria-label="{{ footer.redes[0].nombre }}">{{ ic.red(footer.redes[0].nombre) }}</a>
            <a href="{{ footer.redes[1].href }}" target="_blank" rel="noopener" aria-label="{{ footer.redes[1].nombre }}">{{ ic.red(footer.redes[1].nombre) }}</a>
            <a href="{{ footer.redes[2].href }}" target="_blank" rel="noopener" aria-label="{{ footer.redes[2].nombre }}">{{ ic.red(footer.redes[2].nombre) }}</a>
            <a href="{{ footer.redes[3].href }}" target="_blank" rel="noopener" aria-label="{{ footer.redes[3].nombre }}">{{ ic.red(footer.redes[3].nombre) }}</a>
          </div>
          <div class="platforms">
            {%- for plataforma in footer.plataformas %}
            <a href="{{ plataforma.href }}" target="_blank" rel="noopener">{{ plataforma.nombre }}</a>
            {%- endfor %}
          </div>
        </div>
        <div class="footer__mv">
          <h4>{{ footer.mision.titulo }}</h4>
          <p>{{ footer.mision.texto }}</p>
          <h4>{{ footer.vision.titulo }}</h4>
          <p>{{ footer.vision.texto }}</p>
        </div>
      </div>
      <div class="footer__bottom">
        <span>{{ footer.copyright.textoAntes }}<span id="year"></span>{{ footer.copyright.textoDespues }}</span>
        <a href="#hero">{{ footer.volverArriba }}</a>
      </div>
    </div>
  </footer>

  <script src="script.js?v=15"></script>
</body>
</html>
