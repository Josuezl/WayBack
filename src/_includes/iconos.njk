<svg viewBox="0 0 24 24" width="{{ tam }}" height="{{ tam }}" fill="currentColor" aria-hidden="true"><path d="M12 4v16l-5-4H4a1 1 0 01-1-1V9a1 1 0 011-1h3l5-4zm4.5 3.5l1.4-1.4 2.6 2.6 2.6-2.6 1.4 1.4L21.9 10l2.6 2.6-1.4 1.4-2.6-2.6-2.6 2.6-1.4-1.4L19.1 10 16.5 7.5z" transform="translate(-1.5 2)"/></svg>
