{%- macro play(tam = 22) -%}
<svg viewBox="0 0 24 24" width="{{ tam }}" height="{{ tam }}" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72c0 .38.42.62.75.42l11.02-6.86a.5.5 0 000-.84L8.75 4.72A.5.5 0 008 5.14z"/></svg>
