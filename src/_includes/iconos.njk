{%- endif -%}
{%- endmacro -%}

{#
  Formulario que abre WhatsApp con los datos ya redactados.

  No envia nada a ningun servidor: no hay backend ni servicio de correo, y
  WhatsApp es el canal que la banda ya usa para todo. El JS arma el mensaje
  con las etiquetas visibles de cada campo y abre wa.me.

  `datos` necesita: whatsapp, asunto, boton, campos[{name,label,tipo,requerido,ancho}]
#}
{%- macro formulario(datos, id) -%}
<form class="card card--white form reveal" id="{{ id }}" novalidate
      data-whatsapp="{{ datos.whatsapp }}" data-asunto="{{ datos.asunto }}">
  {%- for campo in datos.campos %}
  <label class="field{% if campo.ancho == 'medio' %} field--medio{% endif %}">
    <span>{{ campo.label }}{% if campo.requerido %} *{% endif %}</span>
    {%- if campo.tipo == "textarea" %}
    <textarea name="{{ campo.name }}" rows="4" data-label="{{ campo.label }}"{% if campo.requerido %} required{% endif %}></textarea>
    {%- else %}
    <input type="{{ campo.tipo }}" name="{{ campo.name }}" data-label="{{ campo.label }}"{% if campo.requerido %} required{% endif %}{% if campo.tipo == "tel" %} inputmode="tel"{% endif %} />
    {%- endif %}
  </label>
  {%- endfor %}
  <button class="btn btn--green btn--block" type="submit">{{ ic_wa() }}{{ datos.boton }}</button>
</form>
{%- endmacro -%}

{%- macro ic_wa(tam = 20) -%}
<svg viewBox="0 0 24 24" width="{{ tam }}" height="{{ tam }}" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.413c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.207z"/></svg>
{%- endmacro -%}

{#
  Imagen que puede estar o no entregada.

  Si el dato trae `src`, se usa la foto real. Si no, se emite el pixel
  transparente con `data-ph` y script.js pinta el placeholder de marca.

  Esto es lo que el spec prometia desde la Fase 1 —"reemplazar una foto es un
  cambio de datos, no de plantilla"— y lo que faltaba para que el cliente
  pudiera hacerlo desde el CMS sin tocar codigo.
#}
{%- set pixelVacio = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" -%}

{%- macro foto(item, clases = "") -%}
{%- if item.src -%}
<img src="{{ item.src }}" alt="{{ item.alt }}" loading="lazy"{% if clases %} class="{{ clases }}"{% endif %} />
{%- else -%}
<img src="{{ pixelVacio }}" data-ph="{{ item.ph }}" alt="{{ item.alt }}"{% if clases %} class="{{ clases }}"{% endif %} />
{%- endif -%}
{%- endmacro -%}
